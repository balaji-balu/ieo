{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capabilities (EN → LO, SPEC §11.2): Margo DeviceCapabilitiesManifest properties plus labels",
  "type": "object",
  "required": ["hostId", "capabilities", "labels"],
  "properties": {
    "hostId": { "$ref": "defs.schema.json#/$defs/hostId" },
    "capabilities": {
      "description": "SPEC §4.1.3. Only the identity fields are required; hosting fields are type-checked.",
      "type": "object",
      "required": ["id", "vendor", "modelNumber", "serialNumber"],
      "properties": {
        "id": { "$ref": "defs.schema.json#/$defs/deviceId" },
        "vendor": { "type": "string" },
        "modelNumber": { "type": "string" },
        "serialNumber": { "type": "string" },
        "cpus": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cores"],
            "properties": {
              "cores": { "type": "number" },
              "architecture": { "type": "string" }
            }
          }
        },
        "memory": { "type": "string" },
        "storage": { "type": "string" },
        "peripherals": { "type": "array", "items": { "type": "object", "required": ["type"] } },
        "interfaces": { "type": "array", "items": { "type": "object", "required": ["type"] } },
        "otelCollector": { "type": "boolean" },
        "supportedRuntimes": { "type": "array", "items": { "type": "string" } },
        "supportedDeploymentTypes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "labels": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
