// Options defines the unit and config format for runtime lookup
type Options struct {
	AppName string // edge-orch
	Unit    string // co | lo | era
	Ext     string // yaml | json | toml
	Path    string // optional override path
}

// LoadPath locates the config file for the runtime unit.
// Returns absolute path or error. Does NOT create or modify config.
func LoadPath(opts Options) (string, error) {
	if opts.Ext == "" {
		opts.Ext = "yaml"
	}

	// 1️⃣ Explicit path override (dev/debug)
	if opts.Path != "" {
		if exists(opts.Path) {
			return opts.Path, nil
		}
		return "", errors.New("config file not found at override path: " + opts.Path)
	}

	// 2️⃣ OS default path
	if f := osDefault(opts); exists(f) {
		log.Println("failed")
		return f, nil
	}

	return "", errors.New("config file not found at default path; run `edgectl init " + opts.Unit + "`")
}

// Load reads the YAML config from path and unmarshals into out
func Load(path string, out interface{}) error {
	b, err := os.ReadFile(path)
	if err != nil {
		return err
	}

	if err := yaml.Unmarshal(b, out); err != nil {
		return err
	}

	return nil
}

// fileName constructs the filename for a unit
func fileName(o Options) string {
	log.Println(o.Unit + "." + o.Ext)
	return o.Unit + "." + o.Ext
}

// osDefault returns the OS-specific default config path
func osDefault(o Options) string {
	log.Println("osDefault: enter")
	switch runtime.GOOS {
	case "linux":
		log.Println("linux", o.AppName,o.Unit, fileName(o))
		return filepath.Join("/etc", o.AppName, o.Unit, fileName(o))
	case "darwin":
		log.Println("darwin")
		return filepath.Join(
			"/Library/Application Support",
			o.AppName,
			o.Unit,
			fileName(o),
		)
	case "windows":
		log.Println("windows")
		base := os.Getenv("ProgramData")
		if base == "" {
			base = `C:\ProgramData`
		}
		return filepath.Join(
			base,
			o.AppName,
			o.Unit,
			"config",
			fileName(o),
		)
	default:
		return ""
	}
}

