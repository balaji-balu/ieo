FROM docker.io/library/golang:1.25 AS builder
WORKDIR /app

# Copy only go.mod and go.sum first (to leverage Docker layer caching)
COPY go.mod go.sum ./
RUN go mod download

COPY . .
# Static: it runs on Alpine.
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /go/bin/ieo-en ./cmd/en

# The EN runs the Compose CLI (ADR 0003) and exits at startup without it: docker:27-cli is Alpine
# with the Docker CLI and its Compose plugin. The engine is the host's, reached through DOCKER_HOST
# or a mounted socket.
FROM docker.io/library/docker:27-cli
WORKDIR /app
COPY --from=builder /go/bin/ieo-en .

ENTRYPOINT ["./ieo-en"]
CMD []


