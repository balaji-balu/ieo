# Copy to .env next to docker-compose.yaml and fill in the empty values (deploy/README.md).

# CO database
PG_USER=postgres
PG_PASSWORD=
PG_DB=orchestration
PG_HOST=postgres

# CO operator API token for edgectl's EDGECTL_TOKEN: at least 32 bytes (SPEC §6.3, §15.6)
CO_OPERATOR_TOKEN=

# The site this bundle's LO and EN serve
SITE_ID=
# Printed by: docker compose exec co ./ieo-co site add <SITE_ID>
LO_SITE_TOKEN=
# Shared by the NATS server, the LO and the EN; letters and digits only
SITE_NATS_PASSWORD=

EN_HOST_ID=host-1
# Given to workloads as HTTP_OTEL_EXPORTER_OTLP_ENDPOINT (SPEC §9.3)
EN_OTEL_HTTP_ENDPOINT=
