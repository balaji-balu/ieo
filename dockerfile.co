FROM docker.io/library/golang:1.25 AS builder
WORKDIR /app

# Copy only go.mod and go.sum first (to leverage Docker layer caching)
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build -ldflags="-s -w" -o /go/bin/ieo-co ./cmd/co
#RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o co ./cmd/co
# RUN go build -o co ./cmd/co

FROM docker.io/debian:bookworm-slim
WORKDIR /app

# ✅ Correct package manager for Debian
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Git identity for container commits
ENV GIT_AUTHOR_NAME="ieo-bot"
ENV GIT_AUTHOR_EMAIL="bot@ieo.local"
ENV GIT_COMMITTER_NAME="ieo-bot"
ENV GIT_COMMITTER_EMAIL="bot@ieo.local"

COPY --from=builder /go/bin/ieo-co .
COPY ./configs/co.yaml ./configs/co.yaml
#ENTRYPOINT ["/app/co"]

CMD ["./ieo-co", "--config=./configs/co.yaml"]